// Transactional NexoBreak mail. Logo PNGs are derived from the existing NexoNest SVG artwork.
// Embedded CID images require no tracking requests or remotely hosted email assets.
function gameClubCodeMessage_(email, code) {
  if (!/^\d{6}$/.test(code)) throw new Error('Invalid verification code.');
  const logos = gameClubEmailLogos_();
  return {
    to: email, name: 'NexoNest · NexoBreak', subject: 'Your NexoBreak Game Club code',
    body: 'Your Game Club verification code is ' + code + '. It expires in ten minutes.\n\n' +
      'Select or copy the six digits and paste them into any NexoBreak code box in Rhino.\n\n' +
      'Never share this code. Ignore this email if you did not request it.\nNexoBreak by NexoNest · https://nexonest.com',
    htmlBody: gameClubCodeHtml_(code),
    inlineImages: {
      nexonest: Utilities.newBlob(Utilities.base64Decode(logos.nexonest), 'image/png', 'nexonest.png'),
      nexobreak: Utilities.newBlob(Utilities.base64Decode(logos.nexobreak), 'image/png', 'nexobreak.png')
    }
  };
}

function gameClubCodeHtml_(code) {
  if (!/^\d{6}$/.test(code)) throw new Error('Invalid verification code.');
  const digits = code.split('').map(function(digit, index) {
    return (index ? '<td width="6"></td>' : '') + '<td align="center" style="border:1px solid #b9d3cb;border-radius:8px;background:#f3f7f6;padding:14px 0;font:600 30px/1.2 Segoe UI,Arial,sans-serif;color:#222">' + digit + '</td>';
  }).join('');
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your NexoBreak code</title></head>
<body style="margin:0;padding:0;background:#e8f1f0;color:#222;font-family:Segoe UI,Arial,sans-serif">
<div style="display:none;max-height:0;overflow:hidden">Your one-time NexoBreak Game Club code. Valid for 10 minutes.</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#e8f1f0"><tr><td align="center" style="padding:28px 12px">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#fff;border:1px solid #cbdcd6;border-radius:16px">
<tr><td style="padding:22px 28px;border-bottom:1px solid #dce7e3"><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
<td width="54"><img src="cid:nexonest" alt="NexoNest" width="44" style="display:block;border:0"></td><td style="font-size:18px;font-weight:600;letter-spacing:-.4px">NexoNest</td>
<td align="right" style="font-size:11px;letter-spacing:1.6px;color:#4b7c6e">GAME CLUB</td></tr></table></td></tr>
<tr><td style="padding:28px"><table role="presentation" cellspacing="0" cellpadding="0"><tr>
<td width="68"><img src="cid:nexobreak" alt="NexoBreak plug-in" width="52" height="52" style="display:block;border:0"></td>
<td><div style="font-size:22px;font-weight:600;line-height:1.3">NexoBreak</div><div style="font-size:12px;line-height:1.6;color:#6b7280">Your focus companion for Rhino</div></td></tr></table>
<h1 style="margin:26px 0 12px;font-size:27px;line-height:1.25;font-weight:600;letter-spacing:-.6px">Your sign-in code</h1>
<p style="margin:0 0 24px;font-size:15px;line-height:1.7;color:#444">Enter this code in the NexoBreak plug-in to create or restore your Game Club account.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:360px;margin:0 auto"><tr>${digits}</tr></table>
<p style="margin:14px 0 24px;text-align:center;font-size:12px;color:#6b7280">Valid for <strong>10 minutes</strong> · One use only</p>
<p style="margin:12px 0 26px;text-align:center;font-size:12px;line-height:1.7;color:#6b7280">Select the six digits above and copy them.<br>Then paste into any code box in NexoBreak.</p>
<div style="border-top:1px dashed #b8ccc5;padding-top:20px;font-size:12px;line-height:1.8;color:#6b7280">Never share this code. NexoNest will never ask you to send it back.<br>If you did not request it, you can ignore this email.</div>
</td></tr><tr><td style="padding:20px 28px;background:#f3f7f6;border-radius:0 0 16px 16px;font-size:11px;line-height:1.8;color:#6b7280">NexoBreak by <a href="https://nexonest.com" style="color:#4b7c6e;text-decoration:none;font-weight:600">NexoNest</a><br>This is an account verification email, separate from your newsletter preferences.</td></tr>
</table></td></tr></table></body></html>`;
}

// Legacy helper for links in already-delivered emails; new mail contains no copy link.
// This GET is a stateless copy helper. The code stays in the URL fragment,
// never in server query parameters; no account, sheet, mail or authentication mutation occurs.
function gameClubCopyPage_() {
  const logos = gameClubEmailLogos_();
  return HtmlService.createHtmlOutput(`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Copy your code · NexoBreak</title>
<style>*{box-sizing:border-box}body{margin:0;padding:24px;background:#e8f1f0;color:#222;font:16px/1.6 "Segoe UI",Arial,sans-serif}main{max-width:460px;margin:7vh auto;padding:32px;background:white;border:1px solid #cbdcd6;border-radius:16px}.brand{display:flex;align-items:center;gap:14px}img{object-fit:contain}h1{font-size:26px;line-height:1.3;margin:28px 0 12px}p{color:#6b7280;font-size:14px}input{width:100%;font:600 32px/1.3 "Segoe UI",Arial,sans-serif;letter-spacing:10px;text-align:center;padding:18px 10px;background:#f3f7f6;border:1px solid #b9d3cb;border-radius:8px;color:#222}button{width:100%;border:0;border-radius:8px;background:#4b7c6e;color:white;padding:14px;font:600 15px "Segoe UI",Arial,sans-serif;cursor:pointer;margin-top:16px}button:disabled{opacity:.5;cursor:default}#status{min-height:44px}footer{font-size:12px;color:#6b7280;border-top:1px dashed #cbdcd6;padding-top:18px}</style></head><body><main>
<div class="brand"><img width="48" height="48" src="data:image/png;base64,${logos.nexobreak}" alt="NexoBreak"><div><strong>NexoBreak</strong><br><small>Game Club · by NexoNest</small></div><img style="margin-left:auto" width="42" src="data:image/png;base64,${logos.nexonest}" alt="NexoNest"></div>
<h1>Copy your sign-in code</h1><p>Return to NexoBreak in Rhino and paste into any of the six code boxes.</p>
<input id="code" aria-label="Six-digit NexoBreak verification code" readonly autocomplete="off" value=""><button id="copy" disabled>Copy code</button><p id="status" role="status" aria-live="polite">Loading your code…</p><footer>Codes expire 10 minutes after the email request. This page does not sign you in or extend a code.</footer></main>
<script>
const field=document.getElementById('code'), button=document.getElementById('copy'), status=document.getElementById('status');
function showCode(hash){const match=/^#?code=([0-9]{6})$/.exec(hash||'');if(!match){status.textContent='Open this page using the Copy code button in your email.';return;}field.value=match[1];button.disabled=false;status.textContent='Your code stays on this page. Click Copy code, then return to Rhino.';}
if(typeof google!=='undefined'&&google.script&&google.script.url){google.script.url.getLocation(function(value){showCode(value.hash);});}else{showCode(window.location.hash);}
button.addEventListener('click',async function(){let copied=false;try{if(navigator.clipboard&&navigator.clipboard.writeText){await navigator.clipboard.writeText(field.value);copied=true;}}catch(error){}if(!copied){field.focus();field.select();try{copied=document.execCommand('copy');}catch(error){}}status.textContent=copied?'Copied. Paste into NexoBreak in Rhino.':'Code selected. Press Ctrl+C (or Command+C), then paste into NexoBreak.';button.textContent=copied?'Copy again':'Select and copy';});
field.addEventListener('click',function(){field.select();});
</script></body></html>`);
}

// PNG derivatives: NexoNest assets/logo.svg and NexoBreak Assets/Brand/nexobreak-wordmark-light.svg.
function gameClubEmailLogos_() {
  return {"nexonest":"","nexobreak":""};
}
